---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Location from '../components/Location.astro';
import Faq from '../components/Faq.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Sora:wght@100..800&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Barcamp Zürich is a community-shaped unconference. Bring an idea, share what you know, and follow your curiosity." />
		<title>barcamp zürich</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Navbar />
		<main id="main" tabindex="-1">
			<Hero />
			<div class="page-content content-container">
				<HowItWorks />
				<Location />
				<section class="about" id="about" aria-labelledby="about-heading">
					<div class="about-copy">
						<h2 class="content-heading" id="about-heading">About</h2>
						<p>Zürich has an incredible tech community, but we often meet within our own technology bubbles.</p>
						<p>We started Barcamp Zürich to bring those communities together: to exchange ideas, discover new perspectives and connect beyond programming languages, frameworks and job titles.</p>
						<p>Whatever your stack, background or experience level, if you’re curious about tech, you’re welcome here.</p>
						<p class="organizer-names">Mateusz, Hugo and Max</p>
						<p class="organizer-caption">The trio behind Barcamp Zürich.</p>
					</div>
					<figure class="organizers">
						<div class="organizers-portrait">
							<div class="organizers-cutout">
								<img
									src="/organizers.webp"
									alt="Three Barcamp Zürich organizers joining hands"
									width="1440"
									height="1155"
									loading="lazy"
									decoding="async"
								/>
							</div>
						</div>
					</figure>
				</section>
				<Faq />
			</div>
		</main>
	</body>
</html>

<style>
	p { max-width: 36rem; margin: 0; color: var(--color-muted); line-height: 1.75; text-wrap: pretty; }

	.about {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		grid-template-areas: "portrait copy";
		gap: 4rem;
		align-items: center;
		padding-block-start: var(--content-section-gap);
	}

	.about-copy { grid-area: copy; }
	.about-copy > p + p:not([class]) { margin-top: var(--space-md); }
	.about-copy .organizer-names { margin-top: var(--space-xl); color: var(--color-text); font-weight: 500; }
	.organizer-caption { margin-top: var(--space-xs); font-size: 0.875rem; }

	.organizers {
		grid-area: portrait;
		width: 100%;
		margin: 0;
	}

	.organizers-portrait {
		position: relative;
		aspect-ratio: 5 / 4;
	}

	@media (max-width: 47.999rem) {
		.about { grid-template-columns: 1fr; grid-template-areas: "copy" "portrait"; gap: var(--space-xl); }
		.organizers { width: min(100%, 25rem); justify-self: center; }
	}

	.organizers-cutout {
		position: absolute;
		inset: 0 4% 6% 3%;
		overflow: hidden;
		border-radius: var(--content-radius);
		background: var(--color-portrait-background);
	}

	.organizers-cutout img {
		position: absolute;
		inset: auto 8% 0;
		display: block;
		width: 84%;
		height: auto;
	}
</style>
