---
import { env } from 'cloudflare:workers';

interface Event {
	title: string;
	starts_at: number;
	venue: string;
	address: string;
}

let event: Event | null = null;
let unavailable = false;

try {
	event = await env.DB.prepare(`
		SELECT title, starts_at, venue, address
		FROM events
		WHERE published = 1 AND starts_at >= ?1
		ORDER BY starts_at ASC, id ASC
		LIMIT 1
	`).bind(Math.floor(Date.now() / 1000)).first<Event>();
} catch (error) {
	unavailable = true;
	console.error('Failed to load upcoming event', error);
}

const date = event ? new Date(event.starts_at * 1000) : null;
const formattedDate = date ? new Intl.DateTimeFormat('en-GB', {
	dateStyle: 'long',
	timeZone: 'Europe/Zurich',
}).format(date) : '';
const formattedTime = date ? new Intl.DateTimeFormat('en-GB', {
	hour: '2-digit',
	minute: '2-digit',
	hourCycle: 'h23',
	timeZone: 'Europe/Zurich',
}).format(date) : '';
const mapsUrl = event
	? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${event.venue}, ${event.address}`)}`
	: '';
---

<section class="next-event" id="next-event" aria-labelledby="next-event-heading">
	<div class="event-copy">
		<h2 class="content-heading" id="next-event-heading">{event?.title ?? 'Next event'}</h2>
	</div>
	<div class="event-details">
		{event && date ? (
			<dl>
				<div><dt>When</dt><dd><time datetime={date.toISOString()}>{formattedDate} at {formattedTime}</time></dd></div>
				<div><dt>Where</dt><dd>{event.venue}, <a href={mapsUrl}>{event.address}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M10.5 7.5H7.125A1.125 1.125 0 0 0 6 8.625v8.25A1.125 1.125 0 0 0 7.125 18h8.25a1.125 1.125 0 0 0 1.125-1.125V13.5" /></svg></a></dd></div>
			</dl>
		) : (
			<p class="event-message">{unavailable
				? 'Event details are temporarily unavailable. Please check back soon.'
				: 'The next event will be announced soon.'}</p>
		)}
	</div>
	<a class="event-rsvp" href="https://www.meetup.com/barcamp-zurich/events/">RSVP on Meetup</a>
</section>

<style>
	.next-event {
		--content-tint: color-mix(in srgb, var(--color-surface), var(--color-brand) 4%);
		--content-border: color-mix(in srgb, var(--color-border), var(--color-brand) 12%);
		--content-radius: 1.5rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: var(--space-lg);
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--content-border);
		border-radius: var(--content-radius);
		background: var(--content-tint);
		color: var(--color-text);
	}
	.event-copy .content-heading {
		margin: 0;
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}
	.event-details { padding-block-start: var(--space-lg); border-top: 1px solid var(--content-border); }
	.event-message { margin: 0; color: var(--color-muted); font-size: 0.875rem; line-height: 1.65; }
	dl { display: grid; gap: var(--space-md); margin: 0; font-size: 0.875rem; line-height: 1.65; }
	dl > div { display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: start; gap: var(--space-md); }
	dt { color: var(--color-muted); }
	dd { margin: 0; }
	a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		min-height: 44px;
		border-radius: var(--space-xs);
		color: var(--color-brand);
		font-weight: 500;
		line-height: 1.75;
		text-decoration: none;
		transition: color 120ms ease;
	}
	a:is(:hover, :focus-visible) { color: color-mix(in oklch, var(--color-brand) 70%, var(--color-text)); }
	a:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 2px; }
	a svg { width: 1.125rem; height: 1.125rem; flex-shrink: 0; }
	.event-rsvp {
		display: flex;
		justify-content: center;
		width: 100%;
		min-height: 48px;
		padding: var(--space-sm) var(--space-lg);
		border-radius: var(--radius-pill);
		background: var(--color-action);
		color: var(--color-action-text);
		font-size: 0.9375rem;
		font-weight: 500;
		transition: background-color 140ms ease;
	}
	.event-rsvp:is(:hover, :focus-visible) {
		background: var(--color-action-hover);
		color: var(--color-action-text);
	}
	@media (prefers-reduced-motion: reduce) {
		a { transition: none; }
	}
</style>
