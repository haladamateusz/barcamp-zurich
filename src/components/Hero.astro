---
import NextEvent from './NextEvent.astro';
import HeroBackground from './HeroBackground.astro';
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
	<HeroBackground />
	<div class="hero-layout content-container">
		<div class="hero-content">
		<h1 id="hero-heading">A tech unconference <span>shaped by attendees.</span></h1>
		<p>No fixed agenda. Give a 10-minute talk or come to listen - the choice is yours.</p>
		</div>
		<NextEvent />
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		min-height: max(41rem, calc(100svh - 1.5rem));
		padding-block: 11rem 7rem;
		overflow: hidden;
		background: var(--color-page);
		color: var(--color-text);
		text-align: left;
	}
	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(20rem, 1fr);
		align-items: center;
		gap: clamp(2rem, 3vw, 3rem);
	}
	.hero-content { min-width: 0; }
	h1 {
		margin: 0;
		font-size: clamp(3rem, 5vw, 4.5rem);
		line-height: 1.08;
		font-weight: 400;
		letter-spacing: -0.055em;
		text-wrap: balance;
	}
	h1 span { display: block; }
	p {
		max-width: 100%;
		margin: var(--space-lg) 0 0;
		color: var(--color-muted);
		font-size: 1.0625rem;
		line-height: 1.7;
		text-wrap: pretty;
	}
	@media (max-width: 63.999rem) {
		.hero-layout { grid-template-columns: 1fr; gap: 3rem; }
	}
	@media (max-width: 40rem) {
		.hero { padding-block: 10rem 7rem; }
		h1 { font-size: clamp(2.25rem, 8.3vw, 3.5rem); letter-spacing: -0.045em; }
		p { font-size: 1rem; }
	}
</style>
