---
import MeetupIcon from '../assets/icons/meetup.svg';
import LinkedInIcon from '../assets/icons/linkedin.svg';

const socials = [
	{ label: 'Meetup', href: 'https://www.meetup.com/barcamp-zurich/', Icon: MeetupIcon },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/company/barcamp-zurich', Icon: LinkedInIcon },
];
---

<div class="social-icons">
	{socials.map(({ label, href, Icon }) => (
		<a href={href} aria-label={label} title={label}>
			<Icon width="20" height="20" aria-hidden="true" />
		</a>
	))}
</div>

<style>
	.social-icons {
		display: flex;
		justify-content: flex-end;
		gap: var(--space-xs);
	}
	.social-icons a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		color: var(--color-muted);
		transition: color 140ms ease;
	}
	.social-icons a:hover { color: var(--color-text); }
</style>
