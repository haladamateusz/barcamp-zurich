---
import SocialIcons from './SocialIcons.astro';

const links = [
	{ label: 'How it works', href: '#how-it-works' },
	{ label: 'Location', href: '#location' },
	{ label: 'About', href: '#about' },
];
---

<header class="site-header">
	<a class="brand" href="/" aria-label="barcamp zürich home">
		<!-- Crop the export's empty canvas while preserving the original artwork. -->
		<svg class="brand-logo" viewBox="22 342 1876 432" width="220" height="51" aria-hidden="true">
			<image class="logo-light" href="/logo%20horizontal%20light%20mode.svg" width="1920" height="1080" />
			<image class="logo-dark" href="/logo%20horizontal%20dark%20mode.svg" width="1920" height="1080" />
		</svg>
	</a>

	<nav class="desktop-nav" aria-label="Main navigation">
		<ul>
			{links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
		</ul>
	</nav>
	<div class="desktop-socials">
		<SocialIcons />
	</div>

	<details class="mobile-menu">
		<summary aria-label="Navigation menu">
			<span class="menu-label">Menu</span>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
				<path class="menu-line-top" d="M4 8h16" />
				<path class="menu-line-bottom" d="M4 16h16" />
			</svg>
		</summary>
		<nav class="mobile-panel" aria-label="Mobile navigation">
			<ul>
				{links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
			</ul>
			<hr class="mobile-separator" />
			<ul class="mobile-socials" aria-label="Social platforms">
				<li><span>Meetup</span></li>
				<li><span>LinkedIn</span></li>
			</ul>
		</nav>
	</details>
</header>
<div class="mobile-menu-backdrop" aria-hidden="true"></div>

<script>
	const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
	if (menu) {
		const summary = menu.querySelector<HTMLElement>('summary')!;
		const panel = menu.querySelector<HTMLElement>('.mobile-panel')!;
		const desktop = window.matchMedia('(min-width: 64rem)');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let closingTimer: ReturnType<typeof setTimeout> | undefined;
		menu.classList.add('is-enhanced');
		panel.inert = true;
		summary.setAttribute('aria-expanded', 'false');

		function setOpen(open: boolean, immediate = false) {
			clearTimeout(closingTimer);
			summary.setAttribute('aria-expanded', String(open));
			panel.inert = !open;
			if (open) {
				menu!.open = true;
				// Establish the starting pose after native details reveals its content.
				void panel.offsetWidth;
				menu!.setAttribute('data-expanded', '');
			} else {
				menu!.removeAttribute('data-expanded');
				if (immediate || reducedMotion.matches) menu!.open = false;
				else closingTimer = setTimeout(() => { menu!.open = false; }, 180);
			}
		}
		const onSummaryClick = (event: MouseEvent) => {
			event.preventDefault();
			setOpen(!menu.hasAttribute('data-expanded'));
		};
		const onMenuClick = (event: MouseEvent) => {
			if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
		};
		const onKeyDown = (event: KeyboardEvent) => {
			if (event.key === 'Escape' && menu.open) {
				setOpen(false);
				summary.focus();
			}
		};
		const onOutsideClick = (event: MouseEvent) => {
			if (menu.open && event.target instanceof Node && !menu.contains(event.target)) setOpen(false);
		};
		const onBreakpoint = () => setOpen(false, true);
		summary.addEventListener('click', onSummaryClick);
		menu.addEventListener('click', onMenuClick);
		document.addEventListener('keydown', onKeyDown);
		document.addEventListener('click', onOutsideClick);
		desktop.addEventListener('change', onBreakpoint);
		document.addEventListener('astro:before-swap', () => {
			clearTimeout(closingTimer);
			summary.removeEventListener('click', onSummaryClick);
			menu.removeEventListener('click', onMenuClick);
			document.removeEventListener('keydown', onKeyDown);
			document.removeEventListener('click', onOutsideClick);
			desktop.removeEventListener('change', onBreakpoint);
		}, { once: true });
	}
</script>

<style>
	.site-header {
		position: fixed;
		top: max(var(--space-lg), env(safe-area-inset-top));
		inset-inline: 0;
		z-index: 10;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: var(--space-md);
		width: min(calc((100% - var(--space-xl) * 2) * 0.66), 52.8rem);
		min-height: 80px;
		margin: 0 auto;
		padding: var(--space-md);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		box-shadow: 0 2px 4px rgb(0 0 0 / 8%), 0 12px 32px rgb(0 0 0 / 8%);
	}

	.brand {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		min-width: 0;
		min-height: 44px;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand-logo { display: block; width: 182px; max-width: 100%; height: auto; flex-shrink: 0; }
	.logo-dark { display: none; }
	@media (prefers-color-scheme: dark) {
		.logo-light { display: none; }
		.logo-dark { display: block; }
	}

	nav ul { display: flex; gap: var(--space-lg); margin: 0; padding: 0; list-style: none; }
	nav a {
		display: flex;
		align-items: center;
		min-height: 44px;
		color: var(--color-muted);
		font-size: 0.9375rem;
		text-decoration: none;
		transition: color 140ms ease;
	}
	nav a:hover { color: var(--color-text); }
	.desktop-socials { justify-self: end; padding-inline-end: var(--space-sm); }
	.mobile-menu { display: none; }
	.mobile-menu-backdrop { display: none; }

	@media (max-width: 63.999rem) {
		.site-header {
			display: flex;
			justify-content: space-between;
			top: max(var(--space-md), env(safe-area-inset-top));
			width: calc(100% - var(--space-md) * 2);
			min-height: 80px;
			gap: var(--space-sm);
			padding: var(--space-md) var(--space-md);
		}
		.desktop-nav, .desktop-socials { display: none; }
		.mobile-menu { display: block; }
		/* Prevent closed details content from contributing overflow in Firefox. */
		.mobile-menu:not([open]) .mobile-panel { display: none; }
		summary {
			display: flex;
			padding-inline-end: var(--space-md);
			align-items: center;
			justify-content: center;
			gap: var(--space-sm);
			min-height: 44px;
			min-width: 44px;
			border-radius: var(--radius-pill);
			cursor: pointer;
			list-style: none;
			font-size: 0.875rem;
		}
		summary::-webkit-details-marker { display: none; }
		summary:hover { color: var(--color-brand); }
		.menu-line-top, .menu-line-bottom {
			transform-box: fill-box;
			transform-origin: center;
			transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
		}
		:is(.mobile-menu[data-expanded], .mobile-menu:not(.is-enhanced)[open]) .menu-line-top {
			transform: translateY(4px) rotate(45deg);
		}
		:is(.mobile-menu[data-expanded], .mobile-menu:not(.is-enhanced)[open]) .menu-line-bottom {
			transform: translateY(-4px) rotate(-45deg);
		}
		.is-enhanced .mobile-panel {
			opacity: 0;
			transform: translateY(-8px) scale(0.98);
			transform-origin: top right;
			transition: opacity 180ms ease-out, transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
		}
		.is-enhanced[data-expanded] .mobile-panel {
			opacity: 1;
			transform: translateY(0) scale(1);
			transition-duration: 240ms;
		}
		.mobile-menu-backdrop {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 9;
			background: rgb(0 0 0 / 8%);
			-webkit-backdrop-filter: blur(6px);
			backdrop-filter: blur(6px);
			opacity: 0;
			pointer-events: none;
			transition: opacity 180ms ease-out;
		}
		.site-header:has(.mobile-menu[data-expanded]) + .mobile-menu-backdrop {
			opacity: 1;
			pointer-events: auto;
			transition-duration: 240ms;
		}
		.mobile-panel {
			position: absolute;
			top: calc(100% + var(--space-sm));
			left: 0;
			right: 0;
			padding: var(--space-md);
			border: 1px solid var(--color-border);
			border-radius: var(--space-lg);
			background: var(--color-surface);
			box-shadow: 0 12px 32px rgb(0 0 0 / 12%);
		}
		.mobile-panel ul { flex-direction: column; gap: var(--space-xs); }
		.mobile-panel ul a { padding-inline: var(--space-md); }
		.mobile-separator {
			margin: var(--space-sm) var(--space-md);
			border: 0;
			border-top: 1px solid var(--color-border);
		}
		.mobile-socials span {
			display: flex;
			align-items: center;
			min-height: 44px;
			padding-inline: var(--space-md);
			color: var(--color-muted);
			font-size: 0.9375rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-line-top, .menu-line-bottom, .is-enhanced .mobile-panel, .mobile-menu-backdrop {
			transition: none;
		}
	}

	@media (max-width: 30rem) {
		.menu-label { display: none; }
	}

	@supports ((backdrop-filter: blur(20px)) or (-webkit-backdrop-filter: blur(20px))) {
		.site-header, .mobile-panel {
			background: color-mix(in srgb, var(--color-surface) 76%, transparent);
			border-color: color-mix(in srgb, var(--color-text) 14%, transparent);
			-webkit-backdrop-filter: blur(20px) saturate(1.12);
			backdrop-filter: blur(20px) saturate(1.12);
		}
		.mobile-panel {
			background: color-mix(in srgb, var(--color-surface) 90%, transparent);
		}
	}
</style>
